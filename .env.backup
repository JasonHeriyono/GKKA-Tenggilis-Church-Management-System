# Aplikasi
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sim_g

# JWT (wajib diganti, min. 32 karakter — buat dengan: openssl rand -hex 32)
JWT_SECRET=rahasia-super-aman-sim-gkka-2026
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# IP reverse proxy (Nginx)
TRUSTED_PROXIES=

# Goose (migrasi)
GOOSE_DRIVER=mysql
GOOSE_DBSTRING="${DB_USER}:${DB_PASSWORD}@tcp(${DB_HOST}:${DB_PORT})/${DB_NAME}?parseTime=true"
GOOSE_MIGRATION_DIR=database/migrations
# Super Admin pertama (dipakai oleh: go run . seed). Password minimal 12 karakter.
# Setelah login pertama, ganti password lewat PUT /users/:id/password lalu hapus nilainya dari .env.
SEED_ADMIN_KODE=ADMIN001
SEED_ADMIN_NAMA=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminGKKA123!
# Google Form (kosongkan form ID kalau belum dipakai)
# File JSON key service account dari Google Cloud, JANGAN di-commit
GOOGLE_CREDENTIALS_FILE=service-account.json
# ID dari URL EDITOR form: https://docs.google.com/forms/d/<ID>/edit (bukan link /viewform)
GOOGLE_FORM_ID_MINGGUAN=1EhYHEEau38ny6j3m2mJckmcw3UlHPGeiZaUjKcJfy8A
GOOGLE_FORM_ID_TAHUNAN=17vEhUV2fGhK-y6FHpAcweKDAdceTdmWUrF_fBkT2gs4